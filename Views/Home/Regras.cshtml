@{
    ViewData["Title"] = "Regras";
}

<h1 class="titulo-menu">Regras</h1>

<div class="chat">
    <div id="chat-mensagens" class="chat-mensagens">
        <div class="msg msg-bot">Olá! Sou o assistente de regras de MTG. Fique a vontade para perguntar sobre regras e interações entre cartas!"</div>
    </div>

    <form id="chat-form" class="chat-form">
        <textarea id="chat-input" class="campo" rows="2" maxlength="600"
                  placeholder="Escreva sua pergunta."></textarea>
        <button type="submit" class="botao" id="chat-enviar">Enviar</button>
    </form>

    <button type="button" class="botao-link" id="chat-limpar">Limpar conversa</button>
</div>

<p><a asp-action="Index" class="link-voltar">← Voltar ao menu</a></p>

@section Scripts {
    <script>
        const urlPergunta = '@Url.Action("PerguntarRegras", "Home")';
        const lista = document.getElementById('chat-mensagens');
        const form = document.getElementById('chat-form');
        const input = document.getElementById('chat-input');
        const botao = document.getElementById('chat-enviar');
        const mensagemInicial = lista.innerHTML;

        let historico = [];
        let enviando = false;

        function adicionar(papel, texto) {
            const div = document.createElement('div');
            div.className = 'msg ' + (papel === 'user' ? 'msg-user' : 'msg-bot');
            div.textContent = texto;          // textContent: nunca interpreta HTML
            lista.appendChild(div);
            lista.scrollTop = lista.scrollHeight;
            return div;
        }

        // Enter envia; Shift+Enter quebra a linha
        input.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                form.requestSubmit();
            }
        });

        form.addEventListener('submit', async e => {
            e.preventDefault();

            const pergunta = input.value.trim();
            if (!pergunta || enviando) return;

            enviando = true;
            botao.disabled = true;
            input.value = '';

            adicionar('user', pergunta);
            const carregando = adicionar('bot', 'Consultando as regras...');
            carregando.classList.add('msg-carregando');

            let texto, ok = false;

            try {
                const r = await fetch(urlPergunta, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pergunta, historico: historico.slice(-6) })
                });

                if (r.status === 429) {
                    texto = 'Muitas perguntas em pouco tempo. Aguarde alguns minutos e tente de novo.';
                } else if (!r.ok) {
                    texto = 'Algo deu errado. Tente novamente.';
                } else {
                    texto = (await r.json()).resposta;
                    ok = true;
                }
            } catch {
                texto = 'Não consegui conectar. Tente novamente.';
            }

            carregando.textContent = texto;
            carregando.classList.remove('msg-carregando');
            lista.scrollTop = lista.scrollHeight;

            if (ok) {
                historico.push({ papel: 'user', texto: pergunta });
                historico.push({ papel: 'assistant', texto });
            }

            enviando = false;
            botao.disabled = false;
            input.focus();
        });

        document.getElementById('chat-limpar').addEventListener('click', () => {
            historico = [];
            lista.innerHTML = mensagemInicial;
        });
    </script>
}