@{
    ViewData["Title"] = "Menu";
}

<h1 class="titulo-menu">Menu Principal</h1>

<div class="menu-linhas">

    <div class="menu-linha">
        <a asp-controller="Home" asp-action="Analisar" class="bloco bloco-branco">
            <strong>Analisar</strong>
            <span>Análise estatística de decks de commander e seus status</span>
        </a>

        <a asp-controller="Home" asp-action="CriarDeck" class="bloco bloco-azul">
            <strong>Criar Deck</strong>
            <span>Criação automática de Decks a partir de uma única carta</span>
        </a>

        <a asp-controller="Home" asp-action="Regras" class="bloco bloco-preto">
            <strong>Regras</strong>
            <span>Chat para perguntar sobre regras e interações</span>
        </a>
    </div>

    <div class="menu-linha">
        <a asp-controller="Home" asp-action="Colecoes" class="bloco bloco-grande bloco-vermelho">
            <strong>Coleções</strong>
            <span>Biblioteca de cartas de todas as coleções</span>
        </a>

        <a asp-controller="Home" asp-action="Simulacao" class="bloco bloco-grande bloco-verde">
            <strong>Simulação</strong>
            <span>Veja a porcentagem de vitória de cada deck em uma partida</span>
        </a>
    </div>

</div>